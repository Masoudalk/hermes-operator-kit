# Large binaries / browsers
playwright-browsers/
node_modules/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Hermes runtime
.hermes/

# Logs and tmp - track directories but ignore contents
logs/
!logs/.gitkeep
tmp/
!tmp/.gitkeep

# Backups
*.bak-*
*.bak

# Screenshots
*.png
*.jpg

# Local state
dist/
*.zip

# Personal data - NOT tracked (each user gets their own from templates)
.env
memory/HANDOFF.md
memory/last_launched_apps.txt
memory/gh_login_output.txt
memory/*.archive-*.md
memory/PHASE1_AUDIT.md
memory/SELF_IMPROVEMENT_AUDIT.md
memory/install_ps1_*.ps1

# Personal repos - NOT tracked
brain/
projects/
operator/

# Test files - local development only
test_notepad_*.py
tests/demo_*.py
tests/test_calculator_circuit.py
tests/test_universal.py
