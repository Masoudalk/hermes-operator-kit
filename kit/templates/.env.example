# Hermes Operator Kit - Environment Template
# Copy to .env and fill in your values
HERMES_HOME=C:/Users/%USERNAME%/AppData/Local/hermes
AGENT_WORK=C:/agent-work

# NVIDIA API Key (get from https://build.nvidia.com/settings/api-keys)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Other provider keys (optional)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=